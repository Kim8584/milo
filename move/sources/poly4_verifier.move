        let bad_proof_a = x"f3a47e6a474dda279a0fbb33bdc907b1d33336bf6c744b696749a457bbf50312";
        let last_idx = vector::length(&bad_proof_a) - 1;
        let b = vector::borrow_mut(&mut bad_proof_a, last_idx);
        *b = *b ^ 0x01; // flip a bit

        let proof_b = x"922a00af516eca83da113a0b2bbc7fb729fd1c4948ed871d45a7b0bc0b45ec27892fe0829711435efa3e35fe38f47369b253ea4da3fb265d65ac2f62b9f15695";
